# Environment template
#
# Copy this file to backend/.env before running the backend or docker-compose.
# Fill in real values locally. Never commit a real .env file.

# Cloud credentials
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# LLM providers
VOLCES_API_KEY=
VOLCES_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCES_MODEL=doubao-seed-2-0-pro-260215
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_MODEL=doubao-seed-2-0-pro-260215
LLM_CLEAN_MODEL=doubao-seed-2-0-lite-260428

# Tracing
LANGSMITH_TRACING=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# PostgreSQL used by the backend
PG_HOST=localhost
PG_PORT=5433
PG_DB=knowledge_db
PG_USER=kbuser
PG_PASSWORD=

# Text embedding
EMBEDDING_PROVIDER=volces
EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_DIMENSION=2560
EMBEDDING_BATCH_SIZE=10

# Multimodal embedding
MULTIMODAL_EMBEDDING_PROVIDER=volces
MULTIMODAL_EMBEDDING_MODEL=doubao-embedding-vision-251215
MULTIMODAL_EMBEDDING_DIMENSION=1024

# Vector retrieval
VECTOR_TOP_K=10
VECTOR_SCORE_THRESHOLD=0

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# MinIO used by docker-compose
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# PostgreSQL used by docker-compose
POSTGRES_DB=knowledge_db
POSTGRES_USER=kbuser
POSTGRES_PASSWORD=

# OSS
OSS_BUCKET=
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# API server
API_HOST=0.0.0.0
API_PORT=8000
SSL_VERIFY=false

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=480

# Other runtime options
PRELOAD_GRAPHS=false
KNOWLEDGE_TABLE_URL=http://localhost:8000
